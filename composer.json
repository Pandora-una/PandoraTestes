{
  "name": "pandora-una/pandora-testes",
  "description": "Base da Pandora, com classes abstratas e auxiliares",
  "type": "library",
  "keywords": [
    "framework",
    "laminas",
    "pandora",
    "pandoratestes"
  ],
  "homepage": "http://www.pandora.com.br/",
  "authors": [
    {
      "name": "Vinícius Nascimento Silva",
      "email": "vinicius.silva@pandora.com.br",
      "homepage": "http://www.pandora.com.br/"
    }
  ],
  "license": "proprietary",
  "require": {
    "php": "~8.4.0",
    "behat/behat": "^3.16",
    "behat/mink": "^1.11",
    "behat/mink-selenium2-driver": "^1.7",
    "coduo/php-matcher": "^6.0",
    "doctrine/data-fixtures": "^2.0",
    "doctrine/doctrine-orm-module": "^6.3",
    "doctrine/orm": "^2.20",
    "friends-of-behat/mink-extension": "^2.7",
    "guzzlehttp/guzzle": "^7.9",
    "laminas/laminas-modulemanager": "^2.17",
    "laminas/laminas-servicemanager": "^3.22",
    "phpunit/phpunit": "^12.0"
  },
  "replace": {
    "behat/web-api-extension": "*"
  },
  "config": {
    "platform": {
      "php": "8.4.0"
    }
  },
  "autoload": {
    "psr-0": {
      "PandoraTestes": "src/"
    },
    "psr-4": {
      "Behat\\WebApiExtension\\": "src/WebApiExtension/"
    },
    "classmap": [
      "./Module.php"
    ]
  },
  "bin": [
    "bin/pandora-behat",
    "bin/selenium-server-standalone-2.53.0.jar"
  ]
}
